[
  {
    "id": "results",
    "spec": {
      "title": "Race Results",
      "hideTitle": true,
      "contentWidth": 388,
      "afterAction": "close",
      "canCloseWithEscape": true,
      "buttons": [
        {
          "id": "close",
          "label": "Close",
          "width": 150,
